---
import type { SocialLink } from '../data/types';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';
import Section from './Section.astro';

interface Props {
  email: string;
  note: string;
  socials: SocialLink[];
}

const { email, note, socials } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<Section id="contact" label={t('section.contact')}>
  <div class="card">
    <p class="note">{note}</p>
    <div class="actions">
      <a class="email" href={`mailto:${email}`}>
        <Icon name="mail" size={18} />
        {email}
      </a>
      <button
        class="copy"
        type="button"
        data-copy={email}
        data-text-copy={t('contact.copy')}
        data-text-copied={t('contact.copied')}
        data-text-failed={t('contact.copyFailed')}
        data-status-copied={t('contact.copiedStatus')}
        data-status-failed={t('contact.copyFailedStatus')}
        hidden
      >
        <span class="copy-icon"><Icon name="copy" size={16} /></span>
        <span class="check-icon"><Icon name="check" size={16} /></span>
        <span data-copy-label>{t('contact.copy')}</span><span class="sr-only"> {t('contact.copyTarget')}</span>
      </button>
      <p class="sr-only" aria-live="polite" data-copy-status></p>
    </div>
    {
      socials.length > 0 && (
        <p class="elsewhere">
          {t('contact.elsewhere')}{' '}
          {socials.map(({ label, href }, index) => (
            <>
              {index > 0 && (index === socials.length - 1 ? ` ${t('contact.and')} ` : ', ')}
              <a class="link" href={href} target="_blank" rel="noreferrer">
                {label}
                <span class="sr-only"> {t('newTab')}</span>
              </a>
            </>
          ))}.
        </p>
      )
    }
  </div>
</Section>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    const label = button.querySelector('[data-copy-label]');
    const status = button.parentElement?.querySelector('[data-copy-status]');
    // The Clipboard API needs a secure context (HTTPS or localhost); keep the button hidden otherwise.
    if (!navigator.clipboard || !label || !status) continue;
    button.hidden = false;

    // The page's language provides the texts, through data attributes on the button.
    const texts = button.dataset;
    let timer = 0;
    const show = (text: string, message: string) => {
      label.textContent = text;
      // Clear first so screen readers announce the message again on a repeat click.
      status.textContent = '';
      window.setTimeout(() => (status.textContent = message), 50);
    };

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.dataset.copied = '';
        show(texts.textCopied ?? '', texts.statusCopied ?? '');
      } catch {
        show(texts.textFailed ?? '', texts.statusFailed ?? '');
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        delete button.dataset.copied;
        label.textContent = texts.textCopy ?? '';
        status.textContent = '';
      }, 2000);
    });
  }
</script>

<style>
  /* A closing card with a soft accent glow in one corner. */
  .card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 2rem;
    border: 1px solid var(--border);
    border-radius: 1rem;
    background: var(--surface);
    box-shadow: var(--card-shadow);
  }

  .card::before {
    content: '';
    position: absolute;
    top: -60%;
    right: -25%;
    z-index: -1;
    width: 70%;
    aspect-ratio: 1;
    background: radial-gradient(circle, var(--glow), var(--glow-2) 40%, transparent 70%);
    pointer-events: none;
  }

  .note {
    max-width: 32rem;
    color: var(--text);
    font-size: 1.125rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius);
    background: var(--text);
    color: var(--bg);
    font-weight: 500;
    transition: background-color 150ms ease;
  }

  .email:is(:hover, :focus-visible) {
    background: var(--accent);
  }

  .copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: border-color 150ms ease;
  }

  .copy[hidden] {
    display: none;
  }

  .copy:is(:hover, :focus-visible) {
    border-color: var(--muted);
  }

  .check-icon {
    display: none;
    color: var(--accent);
  }

  .copy[data-copied] .check-icon {
    display: block;
  }

  .copy[data-copied] .copy-icon {
    display: none;
  }

  .elsewhere {
    margin-top: 1.5rem;
  }
</style>
