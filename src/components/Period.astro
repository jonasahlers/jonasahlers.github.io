---
import type { YearMonth } from '../data/types';
import { toLocale } from '../i18n/locales';
import { useTranslations } from '../i18n/ui';
import { formatPeriod } from '../lib/format';

interface Props {
  start: YearMonth;
  end?: YearMonth;
}

const { start, end } = Astro.props;
const locale = toLocale(Astro.currentLocale);
const t = useTranslations(locale);
---

<p class="period">
  <span aria-hidden="true">{formatPeriod(start, end, { locale })}</span>
  <span class="sr-only">{formatPeriod(start, end, { locale, separator: t('period.to') })}</span>
</p>

<style>
  .period {
    padding-top: 0.125rem;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.05em;
    line-height: 1.5;
    text-transform: uppercase;
  }
</style>
