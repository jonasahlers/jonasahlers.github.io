---
import { Image } from 'astro:assets';
import { initials } from '../lib/format';

interface Props {
  name: string;
  photo?: ImageMetadata;
}

const { name, photo } = Astro.props;
---

{/* Decorative: the name is printed right beside it. */}
<span class="avatar" aria-hidden="true">
  {photo ? <Image src={photo} alt="" width={128} height={128} /> : initials(name)}
</span>

<style>
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    /* Slightly smaller on short screens so the pinned sidebar still fits. */
    width: clamp(3rem, 7vh, 4rem);
    height: clamp(3rem, 7vh, 4rem);
    overflow: hidden;
    border-radius: 1.125rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: var(--on-accent);
    font-family: var(--font-display, Georgia, serif);
    font-size: 1.75rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 12px 28px -14px var(--accent);
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
