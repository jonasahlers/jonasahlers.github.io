---
interface Props {
  id: string;
  label: string;
}

const { id, label } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="heading">{label}</h2>
  <slot />
</section>

<style>
  .section {
    margin-bottom: 6rem;
  }

  /* Mobile: a sticky, translucent label bar per section. */
  .heading {
    position: sticky;
    top: 0;
    z-index: 20;
    margin: 0 calc(var(--gutter) * -1) 1rem;
    padding: 1.25rem var(--gutter);
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: blur(8px);
    color: var(--text);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* Desktop: a quiet label followed by a hairline rule. */
  @media (min-width: 1024px) {
    .section {
      margin-bottom: 7.5rem;
    }

    .heading {
      position: static;
      display: flex;
      align-items: center;
      gap: 1rem;
      margin: 0 0 1.75rem;
      padding: 0;
      background: none;
      backdrop-filter: none;
    }

    .heading::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
  }
</style>
