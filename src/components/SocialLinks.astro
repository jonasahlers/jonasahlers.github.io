---
import type { SocialLink } from '../data/types';
import { useTranslations } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  links: SocialLink[];
  email: string;
}

const { links, email } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<ul class="socials" role="list">
  {
    links.map(({ label, href, icon }) => (
      <li>
        <a class="social" href={href} target="_blank" rel="noreferrer" title={label}>
          <Icon name={icon} size={22} />
          <span class="sr-only">{label} {t('newTab')}</span>
        </a>
      </li>
    ))
  }
  <li>
    <a class="social" href={`mailto:${email}`} title={t('social.email')}>
      <Icon name="mail" size={22} />
      <span class="sr-only">{t('social.email')}</span>
    </a>
  </li>
</ul>

<style>
  .socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .social {
    display: block;
    margin: -0.25rem;
    padding: 0.25rem;
    color: var(--muted);
    transition: color 150ms ease;
  }

  .social:is(:hover, :focus-visible) {
    color: var(--text);
  }
</style>
