---
import { useTranslations } from '../i18n/ui';
import Section from './Section.astro';

interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
const t = useTranslations(Astro.currentLocale);
---

<Section id="about" label={t('section.about')}>
  <div class="about">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 1rem;
    text-wrap: pretty;
  }

  /* The first paragraph is the lede: what a visitor reads first. */
  .about p:first-child {
    color: var(--text);
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
</style>
