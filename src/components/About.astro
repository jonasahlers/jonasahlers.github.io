---
import Section from './Section.astro';

interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
---

<Section id="about" label="About">
  <div class="about">
    {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: 1rem;
    text-wrap: pretty;
  }

  /* The first paragraph is the lede: what a visitor reads first. */
  .about p:first-child {
    color: var(--text);
    font-size: 1.25rem;
    line-height: 1.55;
    letter-spacing: -0.012em;
  }
</style>
