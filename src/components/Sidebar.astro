---
import type { Profile } from '../data/types';
import type { SectionLink } from '../lib/sections';
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import SocialLinks from './SocialLinks.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  profile: Profile;
  sections: SectionLink[];
}

const { profile, sections } = Astro.props;
---

<header class="sidebar">
  <div>
    <div class="identity reveal">
      <Avatar name={profile.name} photo={profile.avatar} />
      {
        profile.availability && (
          <p class="status">
            <span class="status-dot" aria-hidden="true" />
            {profile.availability}
          </p>
        )
      }
    </div>
    <h1 class="name reveal" style="--order: 1">{profile.name}</h1>
    <p class="role reveal" style="--order: 2">{profile.role}</p>
    <p class="tagline reveal" style="--order: 3">{profile.tagline}</p>
    {
      profile.location && (
        <p class="location reveal" style="--order: 4">
          <Icon name="map-pin" size={16} />
          {profile.location}
        </p>
      )
    }
    <nav class="nav reveal" style="--order: 5" aria-label="Sections">
      <ul role="list">
        {
          sections.map(({ id, label }) => (
            <li>
              <a class="nav-link" href={`#${id}`} data-section={id}>
                <span class="nav-line" aria-hidden="true" />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
  <div class="footer reveal" style="--order: 6">
    <SocialLinks links={profile.socials} email={profile.email} />
    <ThemeToggle />
  </div>
</header>

<script>
  // Scroll-spy: the active section is the last one whose top has passed 30% of the viewport,
  // or the final section once the page is scrolled to the bottom (it may be too short to get there).
  // A section picked from the nav stays active until the visitor scrolls by hand, since short
  // sections near the end can't always scroll far enough to pass that line.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-section]')];
  const sections = links.map((link) => document.getElementById(link.dataset.section ?? ''));
  let picked: number | undefined;

  function highlight(active: number) {
    links.forEach((link, index) => {
      if (index === active) link.setAttribute('aria-current', 'true');
      else link.removeAttribute('aria-current');
    });
  }

  function update() {
    if (picked !== undefined) return highlight(picked);
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    let active = 0;
    sections.forEach((section, index) => {
      if (section && section.getBoundingClientRect().top <= window.innerHeight * 0.3) active = index;
    });
    highlight(atBottom ? links.length - 1 : active);
  }

  function pick(index: number) {
    picked = index >= 0 ? index : undefined;
    update();
  }

  // The hash covers nav clicks, Back/Forward, and deep links like /#education on load.
  const pickFromHash = () => pick(links.findIndex((link) => link.hash === location.hash));
  links.forEach((link, index) => link.addEventListener('click', () => pick(index)));
  window.addEventListener('hashchange', pickFromHash);
  for (const type of ['wheel', 'touchstart', 'keydown', 'pointerdown'] as const) {
    window.addEventListener(type, () => (picked = undefined), { passive: true });
  }

  // Browsers fire scroll and resize at most once per frame, so no extra throttling is needed.
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  pickFromHash();
</script>

<style>
  .sidebar {
    padding-top: 4rem;
  }

  @media (min-width: 1024px) {
    .sidebar {
      position: sticky;
      top: 0;
      align-self: flex-start;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      width: 48%;
      height: 100vh;
      /* If the content is ever taller than the window, scroll the sidebar rather than cut it off.
         The inline padding (offset by the margin) keeps focus rings at the left edge unclipped. */
      overflow-y: auto;
      margin-left: -0.5rem;
      padding: var(--page-top) 0.5rem;
    }
  }

  /* Too short to pin everything on screen: let the sidebar scroll with the page instead. */
  @media (min-width: 1024px) and (max-height: 640px) {
    .sidebar {
      position: static;
      height: auto;
      overflow-y: visible;
    }
  }

  /* Vertical spacing in the sidebar scales with window height so it fits pinned on laptops. */
  .identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: clamp(1rem, 3vh, 1.75rem);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .status-dot {
    position: relative;
    flex: none;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentColor;
  }

  @media (prefers-reduced-motion: no-preference) {
    .status-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: currentColor;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    70%,
    100% {
      transform: scale(2.6);
      opacity: 0;
    }
  }

  .name {
    color: var(--text);
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(2.75rem, 1.9rem + 2.9vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .role {
    margin-top: 0.75rem;
    color: var(--accent);
    font-size: 1.125rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .role {
      font-size: 1.25rem;
    }
  }

  .tagline {
    max-width: 23rem;
    margin-top: 1rem;
    line-height: 1.6;
    text-wrap: pretty;
  }

  .location {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .nav {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav {
      display: block;
      margin-top: clamp(1.25rem, 5vh, 4rem);
    }
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding-block: clamp(0.375rem, 1.1vh, 0.625rem);
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition: color 150ms ease;
  }

  .nav-line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition: width 150ms ease;
  }

  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-link[aria-current] {
    color: var(--text);
  }

  .nav-link:hover .nav-line,
  .nav-link:focus-visible .nav-line,
  .nav-link[aria-current] .nav-line {
    width: 4rem;
  }

  .nav-link[aria-current] .nav-line {
    background: var(--accent);
  }

  .footer {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: clamp(1rem, 3vh, 2rem);
  }
</style>
